# Copy to .env and fill in. Never commit .env.

# Required — Google Gemini API key (free tier at https://ai.google.dev)
export GEMINI_API_KEY=""

# Optional — Gemini model override (default: gemini-2.0-flash)
# export GEMINI_MODEL="gemini-2.0-flash"

# Optional — Discord bot (discord_bot.py)
export DISCORD_BOT_TOKEN=""

# Optional — Discord webhook for notifications and the weekly digest
export DISCORD_WEBHOOK_URL=""

# Optional — comma-separated Discord user IDs allowed to open terminal sessions
# export TERMINAL_ADMIN_IDS="123456789"
# export TERMINAL_WORKDIR="/path/to/project"

# Optional — form backend for generated landing pages (e.g. https://formspree.io/f/xxxx)
# export FORM_ENDPOINT=""
